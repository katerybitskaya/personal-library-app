@model LoginViewModel
@inject PersonalLibrary.Services.LocalizationService L
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@L.CurrentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@L["Login_Title"] — Personal Library</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 7v14' fill='none' stroke='%23c9a84c' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/><path d='M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z' fill='none' stroke='%23c9a84c' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>" />
</head>
<body>
<main class="login-page">
    <div class="card card-lg login-card">
        <div class="login-header">
            <div class="login-brand">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 7v14"/>
                    <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
                </svg>
                Personal Library
            </div>
            <div class="lang-switcher login-lang">
                @foreach (var lang in new[] { ("en","EN"), ("ru","RU"), ("pl","PL") })
                {
                    <form asp-controller="Home" asp-action="SetLanguage" method="post">
                        <input type="hidden" name="culture" value="@lang.Item1" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="lang-btn @(L.CurrentCulture == lang.Item1 ? "active" : "")">@lang.Item2</button>
                    </form>
                }
            </div>
        </div>
        <h1 class="login-title">@L["Login_Title"]</h1>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="login-error" role="alert">@Model.Error</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" autocomplete="on">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-group">
                <label class="form-label" for="Username">@L["Login_Username"]</label>
                <input class="form-control" id="Username" name="Username" value="@Model.Username"
                       autocomplete="username" autofocus required />
            </div>
            <div class="form-group">
                <label class="form-label" for="Password">@L["Login_Password"]</label>
                <input class="form-control" id="Password" name="Password" type="password"
                       autocomplete="current-password" required />
            </div>
            <label class="login-remember">
                <input type="checkbox" name="RememberMe" value="true" @(Model.RememberMe ? "checked" : "") />
                @L["Login_Remember"]
            </label>
            <button type="submit" class="btn btn-primary login-submit">@L["Login_Submit"]</button>
        </form>
    </div>
</main>
</body>
</html>
