@inject PersonalLibrary.Services.LocalizationService L
@model HistoryViewModel

@{
    ViewData["Title"] = L["History_Title"];
}
@Html.AntiForgeryToken()

<div class="page-header">
    <h1 class="page-title">@L["History_Title"]</h1>
    @if (Model.Entries.Any())
    {
        <span class="badge badge-dim">@Model.TotalCount</span>
        <button class="btn btn-ghost btn-sm" onclick="confirmClearHistory()" style="margin-left:auto">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"/></svg>
            @L["History_Clear"]
        </button>
    }
</div>

@if (!Model.Entries.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <div class="empty-state-title">@L["History_Empty"]</div>
    </div>
}
else
{
    <div class="card card-lg" style="padding:0">
        <div class="history-list @(Model.Page > 1 ? "history-list-older" : "")" style="padding:0.5rem 1.5rem">
            @foreach (var (entry, i) in Model.Entries.Select((e,i)=>(e,i)))
            {
                var msg = TranslateEntry(entry, L);
                <div class="history-entry" style="animation-delay:@(Math.Min(i,30)*20)ms">
                    <div class="history-time">
                        <span style="opacity:0.6">@L.FormatDate(entry.Timestamp)</span>
                        <span style="margin-left:0.4rem;color:var(--text-secondary)">@entry.Timestamp.ToString("HH:mm")</span>
                    </div>
                    <div class="history-message">@msg</div>
                </div>
            }
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        var current = Model.Page;
        var last = Model.TotalPages;
        // Номера страниц: первая, последняя и по две вокруг текущей; пропуски — «…»
        var pages = Enumerable.Range(1, last)
            .Where(p => p == 1 || p == last || Math.Abs(p - current) <= 2)
            .ToList();

        <nav class="pager" aria-label="@L["Pager_Label"]">
            <div class="pager-info">@string.Format(L["Pager_Info"], Model.FirstItem, Model.LastItem, Model.TotalCount)</div>
            <div class="pager-links">
                @if (current > 1)
                {
                    <a class="pager-btn" asp-action="Index" asp-route-page="@(current - 1)" aria-label="@L["Pager_Prev"]">‹<span class="pager-text"> @L["Pager_Prev"]</span></a>
                }
                else
                {
                    <span class="pager-btn disabled">‹<span class="pager-text"> @L["Pager_Prev"]</span></span>
                }

                @for (var k = 0; k < pages.Count; k++)
                {
                    if (k > 0 && pages[k] - pages[k - 1] > 1)
                    {
                        <span class="pager-gap">…</span>
                    }
                    if (pages[k] == current)
                    {
                        <span class="pager-btn active" aria-current="page">@pages[k]</span>
                    }
                    else
                    {
                        <a class="pager-btn" asp-action="Index" asp-route-page="@pages[k]">@pages[k]</a>
                    }
                }

                @if (current < last)
                {
                    <a class="pager-btn" asp-action="Index" asp-route-page="@(current + 1)" aria-label="@L["Pager_Next"]"><span class="pager-text">@L["Pager_Next"] </span>›</a>
                }
                else
                {
                    <span class="pager-btn disabled"><span class="pager-text">@L["Pager_Next"] </span>›</span>
                }
            </div>
        </nav>
    }
}

@section Scripts {
<script>
function confirmClearHistory() {
    openConfirmModal('@L["History_ConfirmClear"]', async () => {
        const fd = new FormData(); fd.append('__RequestVerificationToken',getAntiForgeryToken());
        const d = await (await fetch('/History/Clear',{method:'POST',body:fd})).json();
        if (d.success) { showToast('@L["History_Clear"]','success'); setTimeout(()=>location.reload(),800); }
    });
}
</script>
}

@functions {
    // Переводит запись истории на текущий язык
    // Запись может быть в старом формате (Message) или новом (MessageKey + Params)
    static string TranslateEntry(PersonalLibrary.Models.HistoryEntry entry, PersonalLibrary.Services.LocalizationService L)
    {
        // Новый формат: есть ключ
        if (!string.IsNullOrEmpty(entry.MessageKey))
        {
            var template = L[entry.MessageKey];
            if (entry.Params.Count > 0)
            {
                // Параметры которые сами являются ключами локализации — переводим
                var translatedParams = entry.Params
                    .Select(p => p.StartsWith("Label_") || p.StartsWith("Hist_") ? L[p] : p)
                    .Cast<object>()
                    .ToArray();
                try { return string.Format(template, translatedParams); }
                catch { return template; }
            }
            return template;
        }

        // Старый формат: готовый текст (обратная совместимость)
        return entry.Message;
    }
}
