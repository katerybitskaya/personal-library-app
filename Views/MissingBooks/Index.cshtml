@inject PersonalLibrary.Services.LocalizationService L
@model MissingBooksViewModel

@{
    ViewData["Title"] = L["Missing_Title"];
}

<div class="page-header">
    <h1 class="page-title">@L["Missing_Title"]</h1>
    @if (Model.Items.Any())
    {
        <span class="badge badge-gold">@Model.Items.Count @L["Missing_Badge"]</span>
    }
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">✅</div>
        <div class="empty-state-title">@L["Missing_Empty"]</div>
    </div>
}
else
{
    <p style="font-family:var(--font-ui);font-size:0.88rem;color:var(--text-muted);margin-bottom:1.5rem">
        @L["Missing_Hint"]
    </p>
    <div class="missing-grid">
        @foreach (var item in Model.Items)
        {
            <div class="missing-card">
                <a asp-controller="Series" asp-action="Details" asp-route-id="@item.SeriesId" class="missing-card-series flag-card-title">@item.SeriesName</a>
                <div class="missing-card-meta">
                    @if (!string.IsNullOrEmpty(item.Title))
                    {
                        <div><span style="color:var(--text-muted)">@L["Missing_Book"]:</span> <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId" class="flag-card-link">@item.Title</a></div>
                    }
                    <div><span style="color:var(--text-muted)">@L["Missing_Author"]:</span> <a asp-controller="Author" asp-action="Details" asp-route-id="@item.AuthorId" class="flag-card-link">@item.AuthorName</a></div>
                    <div>
                        <span style="color:var(--text-muted)">@L["Missing_Order"]:</span>
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId" class="badge badge-gold" style="margin-left:4px">#@item.OrderInSeries</a>
                    </div>
                </div>
                @if (item.Flags.Any())
                {
                    <div class="flag-badges" style="margin-top:0.6rem">
                        @foreach (var flag in item.Flags)
                        {
                            <span class="badge badge-flag @BookFlags.CssClass(flag)">@L[BookFlags.Key(flag)]</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(item.Note))
                {
                    <p class="flag-card-note flag-out-of-print" style="margin-top:0.6rem">@item.Note</p>
                }
            </div>
        }
    </div>
}
