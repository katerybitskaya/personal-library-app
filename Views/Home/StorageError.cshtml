@inject PersonalLibrary.Services.LocalizationService L

@{
    ViewData["Title"] = L["Storage_ErrorTitle"];
}

<div class="empty-state storage-error">
    <div class="empty-state-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
    </div>
    <div class="empty-state-title">@L["Storage_ErrorTitle"]</div>
    <p class="empty-state-text">@L["Storage_ErrorText"]</p>
    <p class="empty-state-text text-muted">@L["Storage_ErrorHint"]</p>
</div>
