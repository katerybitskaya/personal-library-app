@inject PersonalLibrary.Services.LocalizationService L
@model TrashViewModel

@{
    ViewData["Title"] = L["Trash_Title"];
}
@Html.AntiForgeryToken()

<div class="page-header">
    <h1 class="page-title">@L["Trash_Title"]</h1>
    @if (Model.Items.Any())
    {
        <button class="btn btn-danger btn-sm" onclick="confirmClearTrash()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"/></svg>
            @L["Trash_Clear"]
        </button>
    }
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg></div>
        <div class="empty-state-title">@L["Trash_Empty"]</div>
    </div>
}
else
{
    <div class="missing-grid">
        @foreach (var item in Model.Items)
        {
            var typeLabel = item.ItemType switch {
                PersonalLibrary.Models.TrashItemType.Author => L["Label_Author"],
                PersonalLibrary.Models.TrashItemType.Series => L["Label_Series"],
                _ => L["Label_Book"]
            };
            var typeClass = item.ItemType switch {
                PersonalLibrary.Models.TrashItemType.Author => "trash-type-author",
                PersonalLibrary.Models.TrashItemType.Series => "trash-type-series",
                _ => "trash-type-book"
            };
            <div class="missing-card flag-card trash-item @typeClass" id="trashCard-@item.Id">
                <div class="fav-card-head">
                    <div class="missing-card-series flag-card-title">@L.BookTitle(item.ItemName)</div>
                    <span class="badge badge-flag">@typeLabel</span>
                </div>
                <div class="missing-card-meta">
                    @if (item.ItemType != PersonalLibrary.Models.TrashItemType.Author)
                    {
                        <div><span class="text-muted">@L["Trash_Author"]:</span> @item.AuthorName</div>
                    }
                    @if (!string.IsNullOrEmpty(item.SeriesName))
                    {
                        <div><span class="text-muted">@L["Label_Series"]:</span> @item.SeriesName</div>
                    }
                    <div><span class="text-muted">@L["Trash_Deleted"]:</span> @L.FormatDate(item.DeletedAt) @item.DeletedAt.ToString("HH:mm")</div>
                </div>
                <div class="trash-card-actions">
                    <button class="btn btn-secondary btn-sm" onclick="restoreItem('@item.Id')">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                        @L["Trash_Restore"]
                    </button>
                    <button class="btn btn-danger btn-sm" data-id="@item.Id" data-name="@L.BookTitle(item.ItemName)" onclick="deleteForever(this.dataset.id, this.dataset.name)">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"/></svg>
                        @L["Trash_DeleteForever"]
                    </button>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
async function restoreItem(id) {
    const fd = new FormData(); fd.append('id',id); fd.append('__RequestVerificationToken',getAntiForgeryToken());
    const d = await (await fetch('/Trash/Restore',{method:'POST',body:fd})).json();
    if (d.success) {
        showToast('@L["Toast_Restored"]','success');
        const c = document.getElementById('trashCard-'+id);
        if (c) { c.style.opacity='0'; c.style.transition='opacity 0.3s'; setTimeout(()=>c.remove(),300); }
        softReload();
    } else {
        showToast(d.message || '@L["Error_Unknown"]','error');
    }
}
function deleteForever(id, name) {
    openConfirmModal(`@L["Trash_DeleteForever"]:<br><strong>${escapeHtml(name)}</strong>`, async () => {
        const fd = new FormData(); fd.append('id',id); fd.append('__RequestVerificationToken',getAntiForgeryToken());
        const d = await (await fetch('/Trash/DeleteForever',{method:'POST',body:fd})).json();
        if (d.success) { showToast('@L["Toast_DeletedForever"]','success'); softReload(); }
        else showToast(d.message || document.body.dataset.errorGeneric,'error');
    });
}
function confirmClearTrash() {
    openConfirmModal('@L["Trash_ConfirmClear"]', async () => {
        const fd = new FormData(); fd.append('__RequestVerificationToken',getAntiForgeryToken());
        const d = await (await fetch('/Trash/Clear',{method:'POST',body:fd})).json();
        if (d.success) { showToast('@L["Toast_TrashCleared"]','success'); softReload(); }
    });
}
</script>
}
