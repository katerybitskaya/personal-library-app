@inject PersonalLibrary.Services.LocalizationService L
@model SeriesViewModel

@{
    ViewData["Title"] = Model.Series.Name;
    var series = Model.Series;
    var author = Model.Author;
    var orderedBooks = series.Books.OrderBy(b => b.OrderInSeries ?? 99).ToList();
}
@Html.AntiForgeryToken()

<div style="margin-bottom:1rem">
    <a asp-controller="Author" asp-action="Details" asp-route-id="@author.Id" class="btn btn-ghost btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        @author.Name
    </a>
</div>

<div class="detail-layout">
    <div>
        <div class="detail-photo" onclick="openModal('modalUpdateCover')" title="Click to change cover">
            <div style="z-index:1;color:var(--gold-muted)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width:48px;height:48px"><path d="M4 4v16"/><path d="M8 8v12"/><path d="M12 6v14"/><path d="m16 6 4 14"/></svg></div>
            <div style="font-family:var(--font-ui);font-size:0.75rem;color:var(--text-muted);z-index:1">Add cover</div>
            @if (!string.IsNullOrEmpty(series.CoverPath))
            {
                <img src="@series.CoverPath" alt="@series.Name"
                     style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2"
                     onerror="this.remove()" />
            }
        </div>
        <div style="margin-top:0.75rem;text-align:center">
            <div class="meta-label">@L["Author_DateAdded"]</div>
            <div style="font-family:var(--font-ui);font-size:0.85rem;color:var(--text-secondary)">@L.FormatDate(series.DateAdded)</div>
        </div>
    </div>

    <div class="detail-meta">
        <div>
            <div class="meta-label">@L["Series_Type"]</div>
            <div class="title-row">
                <h1 style="font-size:clamp(1.4rem,3vw,2rem);margin-top:0.25rem">@series.Name</h1>
                <partial name="_FavoriteToggle" model='new FavoriteToggleModel("series", series.Id, series.IsFavorite, true)' />
            </div>
        </div>
        <div>
            <div class="meta-label">@L["Series_Author"]</div>
            <a asp-controller="Author" asp-action="Details" asp-route-id="@author.Id" class="meta-value">@author.Name</a>
        </div>
        <div>
            <partial name="_OngoingToggle" model="series" />
        </div>
        <div class="detail-actions">
            <button class="btn btn-primary btn-sm" onclick="openModal('modalAddBookToSeries')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                @L["Series_AddBook"]
            </button>
            <button class="btn btn-secondary btn-sm" onclick="openModal('modalRenameSeries')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                @L["Series_Rename"]
            </button>
            <button class="btn btn-danger btn-sm" onclick="confirmDeleteSeries()">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"/></svg>
                @L["Series_Delete"]
            </button>
        </div>

        @if (orderedBooks.Any())
        {
            <div class="items-section">
                <div class="items-section-title">@L["Series_Parts"] (@orderedBooks.Count)</div>
                @foreach (var book in orderedBooks)
                {
                    <div style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.6rem;border-radius:var(--radius);border:1px solid transparent;transition:all var(--transition)"
                         onmouseenter="this.style.background='var(--bg-card-hover)';this.style.borderColor='var(--border)'"
                         onmouseleave="this.style.background='';this.style.borderColor='transparent'">
                        <span style="font-family:var(--font-ui);font-size:0.8rem;color:var(--gold-muted);min-width:28px;text-align:right;font-weight:600">@(book.OrderInSeries?.ToString() ?? "·")</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-muted);flex-shrink:0"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" class="item-link @(book.IsMissing ? "text-muted" : "")" style="flex:1">
                            @book.Title
                            <partial name="_BookFlagBadges" model="book" />
                        </a>
                        @if (!book.IsMissing) { <partial name="_FavoriteToggle" model='new FavoriteToggleModel("book", book.Id, book.IsFavorite)' /> }
                        else { <span class="fav-placeholder"></span> }
                        <partial name="_BookFlagButton" model="book" />
                        <button class="btn btn-icon btn-ghost btn-sm" onclick="confirmDeleteBookFromSeries('@book.Id','@book.Title.Replace("'","\\'")')" title="@L["Book_Delete"]" style="opacity:0" onmouseenter="this.style.opacity='1'" onmouseleave="this.style.opacity='0'">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"/></svg>
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted" style="font-family:var(--font-ui);font-size:0.9rem">No books yet.</p>
        }
    </div>
</div>

<div class="modal-overlay" id="modalAddBookToSeries">
    <div class="modal">
        <button class="modal-close" onclick="closeModal('modalAddBookToSeries')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        <h2 class="modal-title">@L["Series_AddBook"]</h2>
        <form id="formAddBookToSeries" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SeriesId" value="@series.Id" />
            <div class="form-group">
                <label class="form-label">@L["Book_Title"] <span class="text-danger">*</span></label>
                <input type="text" name="Title" id="inpAddSBookTitle" class="form-control" placeholder="@L["Book_TitlePlaceholder"]" required />
                <div class="form-hint">@L["Book_MissingHint"]</div>
            </div>
            <div class="form-group">
                <label class="missing-toggle">
                    <input type="checkbox" name="IsMissing" value="true" id="chkAddSBookMissing" />
                    <span class="missing-toggle-switch" aria-hidden="true"></span>
                    <span class="missing-toggle-label">@L["Book_IsMissing"]</span>
                </label>
            </div>
            <div class="form-group">
                <label class="form-label">@L["Series_BookOrder"]</label>
                <input type="number" name="OrderInSeries" class="form-control" min="1" placeholder="@L["Book_OrderPlaceholder"]" />
            </div>
            <div class="form-group">
                <label class="form-label">@L["Book_Cover"]</label>
                <div class="img-preview-wrap"><img id="prevAddSBook" class="img-preview" src="" alt="" /></div>
                <input type="file" name="CoverFile" id="fileAddSBook" class="file-input-hidden" accept="image/*" />
                <button type="button" class="file-pick-btn" id="btnFileAddSBook">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    @L["Book_SelectFile"]
                </button>
            </div>
            <div id="errAddSBook" class="text-danger" style="font-size:0.85rem;margin-bottom:0.5rem;display:none"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modalAddBookToSeries')">@L["Btn_Cancel"]</button>
                <button type="submit" class="btn btn-primary" id="btnAddSBook">@L["Btn_Save"]</button>
            </div>
        </form>
    </div>
</div>

<partial name="_BookFlagsModal" />

<div class="modal-overlay" id="modalRenameSeries">
    <div class="modal">
        <button class="modal-close" onclick="closeModal('modalRenameSeries')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        <h2 class="modal-title">@L["Series_Rename"]</h2>
        <form id="formRenameSeries">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@series.Id" />
            <input type="hidden" name="ItemType" value="series" />
            <div class="form-group">
                <label class="form-label">@L["Series_NewName"] <span class="text-danger">*</span></label>
                <input type="text" name="NewName" class="form-control" value="@series.Name" required />
            </div>
            <div id="errRenameSeries" class="text-danger" style="font-size:0.85rem;margin-bottom:0.5rem;display:none"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modalRenameSeries')">@L["Btn_Cancel"]</button>
                <button type="submit" class="btn btn-primary">@L["Btn_Save"]</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="modalUpdateCover">
    <div class="modal">
        <button class="modal-close" onclick="closeModal('modalUpdateCover')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        <h2 class="modal-title">@L["Series_Cover"]</h2>
        <form id="formUpdateCover" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@series.Id" />
            <input type="hidden" name="ItemType" value="series" />
            <div class="form-group">
                @if (!string.IsNullOrEmpty(series.CoverPath))
                {
                    <img src="@series.CoverPath" class="img-preview has-image" alt="" style="margin-bottom:0.75rem" />
                }
                <input type="file" name="PhotoFile" id="fileUpdateCover" class="file-input-hidden" accept="image/*" />
                <button type="button" class="file-pick-btn" id="btnFileUpdateCover">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    @L["Book_SelectFile"]
                </button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modalUpdateCover')">@L["Btn_Cancel"]</button>
                <button type="submit" class="btn btn-primary" id="btnUpdateCover">@L["Btn_Save"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
initFilePicker('fileAddSBook','prevAddSBook','btnFileAddSBook');
document.getElementById('chkAddSBookMissing')?.addEventListener('change', function () {
    document.getElementById('inpAddSBookTitle').required = !this.checked;
});
initFilePicker('fileUpdateCover',null,'btnFileUpdateCover');

document.getElementById('formAddBookToSeries')?.addEventListener('submit', function(e) {
    e.preventDefault();
    submitFormWithFile(this,'/Series/AddBook','errAddSBook',document.getElementById('btnAddSBook'),'Book added!',()=>{ closeModal('modalAddBookToSeries'); this.reset(); document.getElementById('prevAddSBook').style.display='none'; setTimeout(()=>location.reload(),700); });
});
document.getElementById('formRenameSeries')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const err = document.getElementById('errRenameSeries'); err.style.display='none';
    const d = await (await fetch('/Series/Rename',{method:'POST',body:new FormData(this)})).json();
    if (d.success) { showToast('Series renamed!','success'); setTimeout(()=>location.reload(),700); }
    else { err.textContent=d.message; err.style.display='block'; }
});
document.getElementById('formUpdateCover')?.addEventListener('submit', function(e) {
    e.preventDefault();
    submitFormWithFile(this,'/Series/UpdateCover',null,document.getElementById('btnUpdateCover'),'Cover updated!',()=>{ closeModal('modalUpdateCover'); setTimeout(()=>location.reload(),700); });
});
function confirmDeleteSeries() {
    openConfirmModal('@L["Series_ConfirmDelete"]', async () => {
        const fd = new FormData(); fd.append('seriesId','@series.Id'); fd.append('authorId','@author.Id'); fd.append('__RequestVerificationToken',getAntiForgeryToken());
        const d = await (await fetch('/Series/Delete',{method:'POST',body:fd})).json();
        if (d.success) { showToast('Series moved to trash.','success'); setTimeout(()=>window.location.href='/Author/Details/@author.Id',800); }
        else showToast(d.message,'error');
    });
}
function confirmDeleteBookFromSeries(bookId, bookTitle) {
    openConfirmModal(`Move "${bookTitle}" to trash?`, async () => {
        const fd = new FormData(); fd.append('bookId',bookId); fd.append('seriesId','@series.Id'); fd.append('__RequestVerificationToken',getAntiForgeryToken());
        const d = await (await fetch('/Series/DeleteBook',{method:'POST',body:fd})).json();
        if (d.success) { showToast('Book moved to trash.','success'); setTimeout(()=>location.reload(),700); }
        else showToast(d.message,'error');
    });
}
</script>
}
