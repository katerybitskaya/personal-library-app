@inject PersonalLibrary.Services.LocalizationService L
@model BookViewModel

@{
    ViewData["Title"] = L.BookTitle(Model.Book.Title);
    var book = Model.Book;
    var author = Model.Author;
    var series = Model.ParentSeries;
    var backUrl = series != null 
        ? (Url.Action("Details","Series",new{id=series.Id}) ?? "/") 
        : (Url.Action("Details","Author",new{id=author.Id}) ?? "/");
}
@Html.AntiForgeryToken()

<div style="margin-bottom:1rem">
    <a href="@backUrl" class="btn btn-ghost btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        @(series != null ? series.Name : author.Name)
    </a>
</div>

<div class="detail-layout">
    <div>
        <div class="detail-photo" role="button" tabindex="0" title="@L["Cover_Change"]"
             data-file-input="fileUpdateCover" data-upload-url="/Book/UpdateCover" data-id="@book.Id" data-success="@L["Toast_CoverUpdated"]">
            <div style="z-index:1;color:var(--gold-muted)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:48px;height:48px"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg></div>
            <div style="font-family:var(--font-ui);font-size:0.75rem;color:var(--text-muted);z-index:1">@L["Cover_Add"]</div>
            @if (!string.IsNullOrEmpty(book.CoverPath))
            {
                <img src="@book.CoverPath" alt="@L.BookTitle(book.Title)"
                     onerror="this.parentElement.querySelector('.photo-remove-btn')?.remove(); this.remove()" />
                <button type="button" class="photo-remove-btn" title="@L["Cover_Remove"]" aria-label="@L["Cover_Remove"]"
                        data-remove-url="/Book/RemoveCover" data-confirm="@L["Cover_ConfirmRemove"]" data-removed="@L["Toast_CoverRemoved"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"/></svg>
                </button>
            }
        </div>
        <div style="margin-top:0.75rem;text-align:center">
            <div class="meta-label">@L["Book_DateAdded"]</div>
            <div style="font-family:var(--font-ui);font-size:0.85rem;color:var(--text-secondary)">@L.FormatDate(book.DateAdded)</div>
        </div>
    </div>

    <div class="detail-meta">
        <div>
            <div class="meta-label">@L["Book_Type"]</div>
            <div class="title-row">
                <h1 style="font-size:clamp(1.4rem,3vw,2rem);margin-top:0.25rem">@L.BookTitle(book.Title)</h1>
                @if (!book.IsMissing)
                {
                    <partial name="_FavoriteToggle" model='new FavoriteToggleModel("book", book.Id, book.FavoriteBy.Contains(Me.Id), true)' />
                }
            </div>
        </div>
        <div>
            <div class="meta-label">@L["Book_Author"]</div>
            <a asp-controller="Author" asp-action="Details" asp-route-id="@author.Id" class="meta-value">@author.Name</a>
        </div>
        @if (series != null)
        {
            <div>
                <div class="meta-label">@L["Label_Series"]</div>
                <div class="series-number-line">
                    <a asp-controller="Series" asp-action="Details" asp-route-id="@series.Id" class="meta-value text-gold">@series.Name</a>
                    <span class="badge badge-gold">#@book.DisplayNumber</span>
                    <button type="button" class="btn btn-icon btn-ghost btn-sm series-number-edit" onclick="openModal('modalSeriesNumber')" title="@L["Book_SeriesNumber"]" aria-label="@L["Book_SeriesNumber"]">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </button>
                </div>
            </div>
        }
        <div class="detail-actions">
            <button class="btn btn-secondary btn-sm" onclick="openModal('modalRenameBook')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                @L["Book_Rename"]
            </button>
            <button class="btn btn-danger btn-sm" onclick="confirmDeleteBook()">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"/></svg>
                @L["Book_Delete"]
            </button>
        </div>

        <div class="items-section flags-panel">
            <div class="items-section-title">@L["Book_Flags"]</div>
            <partial name="_BookFlagEditor" model="book" />
        </div>
    </div>
</div>

@if (series != null)
{
<div class="modal-overlay" id="modalSeriesNumber">
    <div class="modal">
        <button class="modal-close" onclick="closeModal('modalSeriesNumber')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        <h2 class="modal-title">@L["Book_SeriesNumber"]</h2>
        <form id="formSeriesNumber">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@book.Id" />
            <div class="form-group">
                <input type="text" name="SeriesNumber" class="form-control" maxlength="10" value="@book.SeriesNumber" placeholder="@book.OrderInSeries" aria-label="@L["Book_SeriesNumber"]" />
                <div class="form-hint">@L["Book_SeriesNumberHint"]</div>
            </div>
            <div id="errSeriesNumber" class="text-danger" style="font-size:0.85rem;margin-bottom:0.5rem;display:none"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modalSeriesNumber')">@L["Btn_Cancel"]</button>
                <button type="submit" class="btn btn-primary">@L["Btn_Save"]</button>
            </div>
        </form>
    </div>
</div>
}

<div class="modal-overlay" id="modalRenameBook">
    <div class="modal">
        <button class="modal-close" onclick="closeModal('modalRenameBook')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        <h2 class="modal-title">@L["Book_Rename"]</h2>
        <form id="formRenameBook">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@book.Id" />
            <div class="form-group">
                <label class="form-label">@L["Book_NewTitle"] <span class="text-danger">*</span></label>
                <input type="text" name="NewName" class="form-control" value="@book.Title" required />
            </div>
            <div id="errRenameBook" class="text-danger" style="font-size:0.85rem;margin-bottom:0.5rem;display:none"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('modalRenameBook')">@L["Btn_Cancel"]</button>
                <button type="submit" class="btn btn-primary">@L["Btn_Save"]</button>
            </div>
        </form>
    </div>
</div>

<input type="file" id="fileUpdateCover" class="file-input-hidden" accept="image/*" />

@section Scripts {
<script>
initImageUpload(document.querySelector('.detail-photo'));
initFlagAutoSave(document.getElementById('formBookFlags'));
document.getElementById('formSeriesNumber')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const err = document.getElementById('errSeriesNumber'); err.style.display='none';
    try {
        const d = await (await fetch('/Book/SetSeriesNumber',{method:'POST',body:new FormData(this)})).json();
        if (d.success) { closeModal('modalSeriesNumber'); showToast('@L["Toast_NumberSaved"]','success'); softReload(); }
        else { err.textContent=d.message; err.style.display='block'; }
    } catch { err.textContent=networkErrorText(); err.style.display='block'; }
});
document.getElementById('formRenameBook')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const err = document.getElementById('errRenameBook'); err.style.display='none';
    const r = await fetch('/Book/Rename',{method:'POST',body:new FormData(this)});
    const d = await r.json();
    if (d.success) { showToast('@L["Toast_Renamed"]','success'); softReload(); }
    else { err.textContent=d.message; err.style.display='block'; }
});
function confirmDeleteBook() {
    openConfirmModal('@L["Book_ConfirmDelete"]', async () => {
        const fd = new FormData(); fd.append('bookId','@book.Id'); fd.append('authorId','@author.Id'); fd.append('__RequestVerificationToken',getAntiForgeryToken());
        const d = await (await fetch('/Book/Delete',{method:'POST',body:fd})).json();
        if (d.success) { showToast('@L["Toast_MovedToTrash"]','success'); setTimeout(()=>window.location.href='@backUrl',800); }
        else showToast(d.message,'error');
    });
}
</script>
}
