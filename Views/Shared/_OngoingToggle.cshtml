@inject PersonalLibrary.Services.LocalizationService L
@model Series

<button type="button" class="ongoing-toggle @(Model.IsOngoing ? "is-on" : "")" data-series-id="@Model.Id"
        aria-pressed="@(Model.IsOngoing ? "true" : "false")" title="@L["Series_OngoingHint"]"
        onclick="event.stopPropagation();event.preventDefault();toggleSeriesOngoing(this)">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
    <span class="ongoing-toggle-text">@L["Series_Ongoing"]</span>
</button>
