@inject PersonalLibrary.Services.LocalizationService L
@model FavoriteToggleModel

<button type="button" class="fav-toggle @(Model.Large ? "fav-toggle-lg" : "btn-sm") @(Model.IsFavorite ? "is-on" : "")"
        data-kind="@Model.Kind" data-id="@Model.Id"
        data-title-on="@L["Favorites_Remove"]" data-title-off="@L["Favorites_Add"]"
        title="@(Model.IsFavorite ? L["Favorites_Remove"] : L["Favorites_Add"])"
        aria-label="@(Model.IsFavorite ? L["Favorites_Remove"] : L["Favorites_Add"])"
        aria-pressed="@(Model.IsFavorite ? "true" : "false")"
        onclick="event.preventDefault();event.stopPropagation();toggleFavorite(this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
</button>
