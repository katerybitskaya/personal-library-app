@inject PersonalLibrary.Services.LocalizationService L

<div class="modal-overlay" id="modalBookFlags">
    <div class="modal">
        <button class="modal-close" onclick="closeModal('modalBookFlags')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        <h2 class="modal-title">@L["Book_Flags"]</h2>
        <p class="flag-modal-book" id="flagModalBook"></p>
        @{ ViewData["FlagFormId"] = "formModalBookFlags"; ViewData["FlagFormFooter"] = true; }
        <partial name="_BookFlagEditor" model="new Book { Id = string.Empty }" view-data="ViewData" />
    </div>
</div>
