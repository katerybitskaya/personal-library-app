@inject PersonalLibrary.Services.LocalizationService L
@model IEnumerable<string>

@{
    const string heart = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"/></svg>";
    var users = Me.ProtectionEnabled ? Me.KnownUsers(Model) : new List<AppUser>();
}
@if (!Me.ProtectionEnabled)
{
    if (Model.Contains(Me.Id))
    {
        <span class="fav-mark" title="@L["Nav_Favorites"]">@Html.Raw(heart)</span>
    }
}
else if (users.Any())
{
    <span class="fav-marks" title="@string.Join(", ", users.Select(u => Me.NameOf(u)))">
        @foreach (var u in users)
        {
            <span class="fav-mark" style="color:@UserColors.Hex(u.Color)">@Html.Raw(heart)</span>
        }
    </span>
}
