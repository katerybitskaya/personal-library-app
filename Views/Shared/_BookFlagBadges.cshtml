@inject PersonalLibrary.Services.LocalizationService L
@model Book

@{
    var flagNames = Model.ActiveFlags.Select(f => L[BookFlags.Key(f)]).ToList();
    var tip = string.Join(", ", flagNames) + (string.IsNullOrEmpty(Model.Note) ? "" : " — " + Model.Note);
}
@if (Model.IsMissing)
{
    if (Model.HasFlags)
    {
        <span class="badge badge-flag @BookFlags.CssClass(Model.ActiveFlags[0])" title="@tip">@L["Missing_Badge"]</span>
    }
    else
    {
        <span class="badge badge-dim">@L["Missing_Badge"]</span>
    }
}
else if (Model.HasFlags)
{
    <span class="flag-badges" title="@tip">
        @foreach (var flag in Model.ActiveFlags)
        {
            <span class="badge badge-flag @BookFlags.CssClass(flag)">@L[BookFlags.Key(flag)]</span>
        }
    </span>
}
