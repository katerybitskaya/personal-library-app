@inject PersonalLibrary.Services.LocalizationService L
@inject Microsoft.Extensions.Options.IOptionsMonitor<PersonalLibrary.Models.ProtectionSettings> Protection

@{
    var currentCulture = L.CurrentCulture;
    var trashCount = ViewBag.TrashCount as int? ?? 0;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
    var isHome = currentController == "home" && currentAction == "index";
    var showLogout = Protection.CurrentValue.Enabled && User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Personal Library</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 7v14' fill='none' stroke='%23c9a84c' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/><path d='M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z' fill='none' stroke='%23c9a84c' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>" />
</head>
<body data-confirm-title="@L["Confirm_Title"]"
      data-confirm-cancel="@L["Confirm_Cancel"]"
      data-confirm-ok="@L["Confirm_Ok"]">

<nav class="navbar">
    <a asp-controller="Home" asp-action="Index" class="navbar-brand">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 7v14"/>
            <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
        </svg>
        Personal Library
    </a>

    <ul class="nav-links">
        <li><a asp-controller="Home" asp-action="Index" class="@(isHome ? "active" : "")">@L["Nav_Catalogue"]</a></li>
        <li><a asp-controller="MissingBooks" asp-action="Index" class="@(currentController == "missingbooks" ? "active" : "")">@L["Nav_MissingBooks"]</a></li>
        <li><a asp-controller="History" asp-action="Index" class="@(currentController == "history" ? "active" : "")">@L["Nav_History"]</a></li>
        <li>
            <a asp-controller="Trash" asp-action="Index" class="@(currentController == "trash" ? "active" : "")">
                @L["Nav_Trash"]
                @if (trashCount > 0) { <span class="nav-badge">@trashCount</span> }
            </a>
        </li>
        @if (showLogout)
        {
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit" class="logout-btn">@L["Nav_Logout"]</button>
                </form>
            </li>
        }
    </ul>

    <div class="lang-switcher">
        @foreach (var lang in new[] { ("en","EN"), ("ru","RU"), ("pl","PL") })
        {
            <form asp-controller="Home" asp-action="SetLanguage" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="culture" value="@lang.Item1" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="lang-btn @(currentCulture == lang.Item1 ? "active" : "")">@lang.Item2</button>
            </form>
        }
    </div>

    <button class="nav-toggle" id="navToggle" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
    </button>
</nav>

<div class="drawer-overlay" id="drawerOverlay"></div>
<aside class="mobile-drawer" id="mobileDrawer">
    <button class="drawer-close" id="drawerClose" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
    </button>
    <ul class="drawer-links">
        <li><a asp-controller="Home" asp-action="Index" class="@(isHome ? "active" : "")">@L["Nav_Catalogue"]</a></li>
        <li><a asp-controller="MissingBooks" asp-action="Index" class="@(currentController == "missingbooks" ? "active" : "")">@L["Nav_MissingBooks"]</a></li>
        <li><a asp-controller="History" asp-action="Index" class="@(currentController == "history" ? "active" : "")">@L["Nav_History"]</a></li>
        <li>
            <a asp-controller="Trash" asp-action="Index" class="@(currentController == "trash" ? "active" : "")">
                @L["Nav_Trash"]
                @if (trashCount > 0) { <span class="nav-badge" style="display:inline-flex">@trashCount</span> }
            </a>
        </li>
        @if (showLogout)
        {
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit" class="logout-btn">@L["Nav_Logout"]</button>
                </form>
            </li>
        }
    </ul>
</aside>

<main class="main-content">
    @RenderBody()
</main>

<div class="toast-container" id="toastContainer"></div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
